        MENUITEM "&Seiteansicht",               57609
        MENUITEM "S&eite einrichten",           57606
        MENUITEM SEPARATOR
        MENUITEM "&Administrator",              ID_ARCHIVO_ADMINISTRADOR
        MENUITEM SEPARATOR
        MENUITEM "S&chließen",                  ID_FILE_CLOSE
        MENUITEM "&Beenden",                    ID_APP_EXIT
    END
    POPUP "&Bearbeiten"
    BEGIN
        MENUITEM "&Rückgängig\tCtrl+Z",         ID_EDIT_UNDO
        MENUITEM SEPARATOR
