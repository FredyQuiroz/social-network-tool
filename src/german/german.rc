END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Neu\tCtrl+N",                ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "Import",                      ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Drucken\tCtrl+D",            57607
        MENUITEM "&Seiteansicht",               57609
        MENUITEM "S&eite einrichten",           57606
        MENUITEM SEPARATOR
        MENUITEM "&Administrator",              ID_ARCHIVO_ADMINISTRADOR
        MENUITEM SEPARATOR
        MENUITEM "S&chließen",                  ID_FILE_CLOSE
        MENUITEM "&Beenden",                    ID_APP_EXIT
    END
    POPUP "&Ansicht"
    BEGIN
        MENUITEM "&Extras",                     ID_VIEW_TOOLBAR
        MENUITEM "&Status",                     ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Browser\tF2",                136
    END
    POPUP "&Extras"
    BEGIN
        MENUITEM "&Server",                     ID_CONFIGURACION_SERVIDORES
        MENUITEM SEPARATOR
        MENUITEM "&Spanisch",                   ID_HERRAMIENTAS_ESPA32771
        MENUITEM "&Deutsch",                    ID_HERRAMIENTAS_GERMAN
        MENUITEM "E&nglisch",                   ID_HERRAMIENTAS_ENGLISH
    END
    POPUP "&Hilfe"
    BEGIN
        MENUITEM "Hilfe\tF1",                   ID_HELP_INDEX
        MENUITEM SEPARATOR
        MENUITEM "Ü&ber das Social Network Tool", ID_APP_ABOUT
    END
END

IDR_TemplateTYPE MENU 
BEGIN
