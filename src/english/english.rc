// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "Import",                      ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Print\tCtrl+P",              57607
        MENUITEM "Print p&review ",             57609
        MENUITEM "Pa&ge setup",                 57606
        MENUITEM SEPARATOR
        MENUITEM "&Administrator",              ID_ARCHIVO_ADMINISTRADOR
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Exit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Statusbar",                  ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Browser\tF2",                136
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Servers",                    ID_CONFIGURACION_SERVIDORES
        MENUITEM SEPARATOR
        MENUITEM "S&panish",                    ID_HERRAMIENTAS_ESPA32771
        MENUITEM "&German",                     ID_HERRAMIENTAS_GERMAN
        MENUITEM "E&nglish",                    ID_HERRAMIENTAS_ENGLISH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Help\tF1",                    ID_HELP_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&About Social Network Tool...", ID_APP_ABOUT
    END
END

IDR_TemplateTYPE MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Import",                      ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Print\tCtrl+P",              57607
        MENUITEM "Print p&review",              57609
        MENUITEM "Page set&up",                 57606
        MENUITEM SEPARATOR
        MENUITEM "&Administrator",              ID_ARCHIVO_ADMINISTRADOR
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Exit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Statusbar",                  ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Browser\tF2",                136
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Servers",                    142
        MENUITEM SEPARATOR
        MENUITEM "S&panish",                    ID_HERRAMIENTAS_ESPA32771
        MENUITEM "&German",                     ID_HERRAMIENTAS_GERMAN
        MENUITEM "E&nglish",                    ID_HERRAMIENTAS_ENGLISH
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Mosaic",                     ID_WINDOW_TILE_HORZ
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Help\tF1",                    ID_HELP_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&About Social Network Tool ...", ID_APP_ABOUT
    END
END


